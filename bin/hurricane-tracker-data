#!/usr/bin/env python3
"""Fetch and normalize official tropical weather and earthquake data.

The Omarchy shell consumes a deliberately small JSON contract from this
helper. Network and archive handling stay outside the long-running QML process,
where response sizes, hosts, zip contents, and cache writes can be bounded.
"""

from __future__ import annotations

