class DataError(RuntimeError):
    """A bounded, user-safe failure while loading external or saved data."""


class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse every redirect so fixed API requests cannot change origin."""

    def redirect_request(self, request, file_pointer, code, message, headers, new_url):
        return None


DIRECT_OPENER = urllib.request.build_opener(NoRedirectHandler())


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds").replace(
        "+00:00", "Z"
    )


def home_directory() -> Path:
    configured = os.environ.get("HOME")
    if configured:
        candidate = Path(configured)
        if candidate.is_absolute():
            return candidate
    try:
        candidate = Path(pwd.getpwuid(os.getuid()).pw_dir)
    except (KeyError, OSError, TypeError) as error:
        raise DataError("User home directory is unavailable") from error
    if not candidate.is_absolute():
        raise DataError("User home directory is unavailable")
    return candidate


def xdg_base_path(environment_name: str, fallback_directory: str) -> Path:
    configured = os.environ.get(environment_name)
    if configured:
        candidate = Path(configured)
        if candidate.is_absolute():
            return candidate
    return home_directory() / fallback_directory


def cache_path() -> Path:
    return xdg_base_path("XDG_CACHE_HOME", ".cache") / "hurricane-tracker" / "storms.json"


def earthquake_cache_path() -> Path:
    return cache_path().with_name("earthquakes.json")


def watch_config_path() -> Path:
    return (
        xdg_base_path("XDG_CONFIG_HOME", ".config")
        / "hurricane-tracker"
        / "watch-places.json"
    )


def omarchy_weather_location_path() -> Path:
    return home_directory() / ".local/state/omarchy/settings/weather.json"


def safe_text(value: Any, limit: int = 160) -> str:
    text = re.sub(r"[\x00-\x1f\x7f]+", " ", str(value or ""))
    return " ".join(text.split())[:limit]


def iso_from_epoch_milliseconds(value: Any) -> str:
    milliseconds = number(value)
    if milliseconds is None:
        return ""
    try:
        moment = dt.datetime.fromtimestamp(milliseconds / 1000, tz=dt.timezone.utc)
    except (OverflowError, OSError, ValueError):
        return ""
    return moment.isoformat(timespec="seconds").replace("+00:00", "Z")


def readable_excerpt(value: Any, limit: int = 900) -> str:
    text = safe_text(value, max(limit + 1, 4096))
    if len(text) <= limit:
        return text

    # Prefer a complete sentence near the limit. When NHC's prose has one
    # unusually long sentence, fall back to a complete word instead of
    # exposing the backend's character boundary in the UI.
    available = max(1, limit - 2)
    window = text[:available]
    sentence_ends = [match.end() for match in re.finditer(r"[.!?](?=\s|$)", window)]
    if sentence_ends and sentence_ends[-1] >= int(limit * 0.62):
        return window[: sentence_ends[-1]].rstrip() + " …"
    word_boundary = window.rfind(" ")
    if word_boundary > 0:
        window = window[:word_boundary]
    return window.rstrip(" ,;:-") + "…"


def number(value: Any, fallback: float | None = None) -> float | None:
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return fallback
    return parsed if math.isfinite(parsed) else fallback


def integer(value: Any, fallback: int = 0) -> int:
    parsed = number(value)
    return int(round(parsed)) if parsed is not None else fallback


def is_safe_url(url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(str(url))
    except ValueError:
        return False
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower() in ALLOWED_HOSTS
        and not parsed.username
        and not parsed.password
    )


def is_safe_earthquake_url(url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(str(url))
        port = parsed.port
    except ValueError:
        return False
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower() in EARTHQUAKE_ALLOWED_HOSTS
        and port in (None, 443)
        and not parsed.username
        and not parsed.password
    )


def is_open_meteo_geocoding_url(url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(str(url))
        port = parsed.port
    except ValueError:
        return False
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower() == OPEN_METEO_GEOCODING_HOST
        and parsed.path == "/v1/search"
        and port in (None, 443)
        and not parsed.username
        and not parsed.password
        and not parsed.fragment
    )


def is_nominatim_reverse_url(url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(str(url))
        port = parsed.port
        parameters = urllib.parse.parse_qs(
            parsed.query, keep_blank_values=True, strict_parsing=True
        )
        required_keys = {
            "format",
            "lat",
            "lon",
            "zoom",
            "addressdetails",
            "layer",
            "accept-language",
        }
        if set(parameters) != required_keys or any(
            len(values) != 1 for values in parameters.values()
        ):
            return False
        latitude = float(parameters.get("lat", [""])[0])
        longitude = float(parameters.get("lon", [""])[0])
    except (ValueError, TypeError):
        return False
    expected = {
        "format": ["jsonv2"],
        "lat": parameters.get("lat", []),
        "lon": parameters.get("lon", []),
        "zoom": ["10"],
        "addressdetails": ["1"],
        "layer": ["address"],
        "accept-language": ["en"],
    }
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower() == NOMINATIM_REVERSE_HOST
        and parsed.path == "/reverse"
        and port in (None, 443)
        and not parsed.username
        and not parsed.password
        and not parsed.fragment
        and parameters == expected
        and math.isfinite(latitude)
        and math.isfinite(longitude)
        and -90 <= latitude <= 90
        and -180 <= longitude <= 180
    )


def is_wttr_location_url(url: str) -> bool:
    try:
        parsed = urllib.parse.urlparse(str(url))
        port = parsed.port
        parameters = urllib.parse.parse_qs(
            parsed.query, keep_blank_values=True, strict_parsing=True
        )
    except (ValueError, TypeError):
        return False
    return (
        parsed.scheme == "https"
        and (parsed.hostname or "").lower() == WTTR_LOCATION_HOST
        and parsed.path == "/"
        and port in (None, 443)
        and not parsed.username
        and not parsed.password
        and not parsed.fragment
        and parameters == {"format": ["j1"]}
    )


def response_header(response: Any, name: str) -> str:
    headers = getattr(response, "headers", None)
    if headers is None:
        return ""
    try:
        return str(headers.get(name, "") or "")
    except (AttributeError, TypeError):
        return ""


def read_bounded_response(
    response: Any,
    maximum: int,
    provider: str,
    require_json: bool = False,
) -> bytes:
    try:
        status_value = getattr(response, "status", None)
        if status_value is None:
            status_value = response.getcode()
        status = int(status_value)
    except (AttributeError, TypeError, ValueError):
        raise DataError(f"{provider} response did not include a valid status")
    if not 200 <= status < 300:
        raise DataError(f"{provider} returned a non-success response")

    if require_json:
        content_type = response_header(response, "Content-Type").split(";", 1)[0].strip().lower()
        if content_type not in {"application/json", "application/geo+json"}:
            raise DataError(f"{provider} response was not JSON")

    declared_length = response_header(response, "Content-Length").strip()
    if declared_length:
        try:
            if int(declared_length) > maximum:
                raise DataError(f"{provider} response exceeded the size limit")
        except ValueError:
            # A missing, malformed, or understated header never replaces the
            # streaming limit below.
            pass

    data = response.read(maximum + 1)
    if len(data) > maximum:
        raise DataError(f"{provider} response exceeded the size limit")
    return data


def fetch_direct_bytes(
    url: str,
    maximum: int,
    url_validator: Callable[[str], bool],
    provider: str,
    accept: str,
    timeout: float,
    require_json: bool = False,
    opener: Any = DIRECT_OPENER,
) -> bytes:
    if not url_validator(url):
        raise DataError(f"remote URL is outside the {provider} allowlist")

    request = urllib.request.Request(
        url,
        headers={"User-Agent": USER_AGENT, "Accept": accept},
    )
    try:
        with opener.open(request, timeout=timeout) as response:
            final_url = str(response.geturl())
            if final_url != url or not url_validator(final_url):
                raise DataError(f"{provider} response attempted to redirect")
            return read_bounded_response(response, maximum, provider, require_json)
    except DataError:
        raise
    except urllib.error.HTTPError as error:
        status = int(error.code or 0)
        error.close()
        if 300 <= status < 400:
            raise DataError(f"{provider} response attempted to redirect") from error
        raise DataError(f"{provider} returned a non-success response") from error
    except Exception as error:
        raise DataError(f"{provider} request failed") from error


def safe_remote_url(value: Any) -> str:
    url = safe_text(value, 2048)
    return url if is_safe_url(url) else ""


def safe_earthquake_url(value: Any) -> str:
    url = safe_text(value, 2048)
    return url if is_safe_earthquake_url(url) else ""


def fetch_bytes(url: str, maximum: int, timeout: int = 18) -> bytes:
    return fetch_direct_bytes(
        url,
        maximum,
        is_safe_url,
        "NHC",
        "application/json, application/vnd.google-earth.kmz, application/xml;q=0.9, */*;q=0.2",
        timeout,
    )


def fetch_earthquake_bytes(url: str, maximum: int, timeout: int = 18) -> bytes:
    return fetch_direct_bytes(
        url,
        maximum,
        is_safe_earthquake_url,
        "USGS",
        "application/geo+json, application/json;q=0.9",
        timeout,
        require_json=True,
    )


def normalize_place_query(value: Any) -> str:
    if not isinstance(value, str):
        raise DataError("place search needs a text query")
    if any(unicodedata.category(character) == "Cc" for character in value):
        raise DataError("place search query contained control characters")
    query = " ".join(value.split())
    if len(query) < 2:
        raise DataError("place search query is too short")
    if len(query) > MAX_PLACE_SEARCH_QUERY_CHARS or len(query.encode("utf-8")) > 512:
        raise DataError("place search query is too long")
    return query


def open_meteo_geocoding_url(query: str) -> str:
    normalized = normalize_place_query(query)
    parameters = urllib.parse.urlencode(
        {
            "name": normalized,
            "count": MAX_PLACE_SEARCH_RESULTS,
            "language": "en",
            "format": "json",
        }
    )
    return f"{OPEN_METEO_GEOCODING_URL}?{parameters}"


def remote_display_text(value: Any, required: bool = False) -> str | None:
    if value is None:
        return None if required else ""
    if not isinstance(value, str):
        return None
    if len(value) > MAX_REMOTE_DISPLAY_FIELD_CHARS:
        return None
    if any(
        unicodedata.category(character) == "Cc" or character in "<>"
        for character in value
    ):
        return None
    normalized = " ".join(value.split())
    if required and not normalized:
        return None
    return normalized


def place_kind(feature_code: str) -> str:
    code = feature_code.upper()
    if code == "PPLC":
        return "Capital"
    if code.startswith("PPLA") or code in {"PPL", "PPLG", "PPLL"}:
        return "City"
    if code.startswith("PPL"):
        return "Community"
    if code.startswith("ADM"):
        return "Region"
    if code.startswith("ISL"):
        return "Island"
    if code.startswith("AIR"):
        return "Airport"
    return "Place"


def normalized_place_search_result(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None

    name = remote_display_text(value.get("name"), required=True)
    admin1 = remote_display_text(value.get("admin1"))
    country = remote_display_text(value.get("country"))
    feature_code = remote_display_text(value.get("feature_code"))
    if name is None or admin1 is None or country is None or feature_code is None:
        return None
    if feature_code and not re.fullmatch(r"[A-Za-z0-9_-]{1,24}", feature_code):
        return None

    latitude_value = value.get("latitude")
    longitude_value = value.get("longitude")
    if (
        isinstance(latitude_value, bool)
        or not isinstance(latitude_value, (int, float))
        or isinstance(longitude_value, bool)
        or not isinstance(longitude_value, (int, float))
    ):
        return None
    latitude = float(latitude_value)
    longitude = float(longitude_value)
    if (
        not math.isfinite(latitude)
        or not math.isfinite(longitude)
        or not -90 <= latitude <= 90
        or not -180 <= longitude <= 180
    ):
        return None

    context_parts = []
    seen = {name.casefold()}
    for part in (admin1, country):
        folded = part.casefold()
        if part and folded not in seen:
            seen.add(folded)
            context_parts.append(part)

    identifier_value = value.get("id")
    identifier = ""
    if (
        isinstance(identifier_value, int)
        and not isinstance(identifier_value, bool)
        and 0 <= identifier_value <= 9_999_999_999
    ):
        identifier = str(identifier_value)
    if not identifier:
        identifier = f"{latitude:.5f}:{longitude:.5f}"

    return {
        "id": f"open-meteo:{identifier}",
        "name": name,
        "context": ", ".join(context_parts),
        "kind": place_kind(feature_code),
        "latitude": round(latitude, 5),
        "longitude": round(longitude, 5),
    }


def normalize_place_search_payload(query: str, value: Any) -> dict[str, Any]:
    normalized_query = normalize_place_query(query)
    if not isinstance(value, dict):
        raise DataError("Open-Meteo response was not an object")
    if value.get("error") is True:
        raise DataError("Open-Meteo rejected the place search")
    rows = value.get("results", [])
    if not isinstance(rows, list):
        raise DataError("Open-Meteo response did not contain a result list")

    results = []
    for row in rows[:MAX_PLACE_SEARCH_RESULTS]:
        result = normalized_place_search_result(row)
        if result is not None:
            results.append(result)
        if len(results) >= MAX_PLACE_SEARCH_RESULTS:
            break
    return {
        "schemaVersion": 1,
        "provider": "open-meteo-geonames",
        "query": normalized_query,
        "results": results,
    }


def fetch_place_search_json(query: str, opener: Any = DIRECT_OPENER) -> Any:
    url = open_meteo_geocoding_url(query)
    raw = fetch_direct_bytes(
        url,
        MAX_OPEN_METEO_RESPONSE_BYTES,
        is_open_meteo_geocoding_url,
        "Open-Meteo",
        "application/json",
        5,
        require_json=True,
        opener=opener,
    )
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DataError("Open-Meteo response was not valid JSON") from error


def search_places(
    query: str,
    fetcher: Callable[[str], Any] = fetch_place_search_json,
) -> dict[str, Any]:
    normalized_query = normalize_place_query(query)
    return normalize_place_search_payload(normalized_query, fetcher(normalized_query))


def normalized_reverse_coordinate(value: Any, minimum: float, maximum: float) -> float:
    if isinstance(value, bool):
        raise DataError("reverse geocoding received an invalid coordinate")
    coordinate = number(value)
    if coordinate is None or not minimum <= coordinate <= maximum:
        raise DataError("reverse geocoding received an invalid coordinate")
    return float(coordinate)


def nominatim_reverse_url(latitude: Any, longitude: Any) -> str:
    latitude_value = normalized_reverse_coordinate(latitude, -90, 90)
    longitude_value = normalized_reverse_coordinate(longitude, -180, 180)
    parameters = urllib.parse.urlencode(
        {
            "format": "jsonv2",
            "lat": f"{latitude_value:.5f}",
            "lon": f"{longitude_value:.5f}",
            "zoom": "10",
            "addressdetails": "1",
            "layer": "address",
            "accept-language": "en",
        }
    )
    return f"{NOMINATIM_REVERSE_URL}?{parameters}"


def normalize_reverse_geocode_payload(
    latitude: Any, longitude: Any, value: Any
) -> dict[str, Any]:
    latitude_value = normalized_reverse_coordinate(latitude, -90, 90)
    longitude_value = normalized_reverse_coordinate(longitude, -180, 180)
    if not isinstance(value, dict):
        raise DataError("Nominatim response was not an object")
    if value.get("error"):
        raise DataError("Nominatim could not identify this location")

    address = value.get("address", {})
    if not isinstance(address, dict):
        raise DataError("Nominatim response did not contain an address")
    raw_fields = {
        "name": value.get("name"),
        "display_name": value.get("display_name"),
        "city": address.get("city"),
        "town": address.get("town"),
        "village": address.get("village"),
        "municipality": address.get("municipality"),
        "hamlet": address.get("hamlet"),
        "suburb": address.get("suburb"),
        "county": address.get("county"),
        "state": address.get("state"),
        "country": address.get("country"),
    }
    fields: dict[str, str] = {}
    for key, raw in raw_fields.items():
        text = remote_display_text(raw)
        if raw is not None and text is None:
            raise DataError("Nominatim response contained unsafe display text")
        fields[key] = text or ""

    name = next(
        (
            fields[key]
            for key in (
                "city",
                "town",
                "village",
                "municipality",
                "hamlet",
                "suburb",
                "county",
                "name",
                "state",
                "country",
            )
            if fields[key]
        ),
        "",
    )
    if not name and fields["display_name"]:
        name = fields["display_name"].split(",", 1)[0].strip()
    if not name:
        raise DataError("Nominatim did not return a usable place name")

    context_parts = []
    seen = {name.casefold()}
    for part in (fields["state"], fields["country"]):
        folded = part.casefold()
        if part and folded not in seen:
            seen.add(folded)
            context_parts.append(part)
    return {
        "schemaVersion": 1,
        "provider": "nominatim-openstreetmap",
        "latitude": round(latitude_value, 5),
        "longitude": round(longitude_value, 5),
        "name": name,
        "context": ", ".join(context_parts),
    }


def fetch_reverse_geocode_json(
    latitude: Any, longitude: Any, opener: Any = DIRECT_OPENER
) -> Any:
    url = nominatim_reverse_url(latitude, longitude)
    raw = fetch_direct_bytes(
        url,
        MAX_NOMINATIM_RESPONSE_BYTES,
        is_nominatim_reverse_url,
        "Nominatim",
        "application/json",
        5,
        require_json=True,
        opener=opener,
    )
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DataError("Nominatim response was not valid JSON") from error


def reverse_geocode_place(
    latitude: Any,
    longitude: Any,
    fetcher: Callable[[float, float], Any] = fetch_reverse_geocode_json,
) -> dict[str, Any]:
    latitude_value = normalized_reverse_coordinate(latitude, -90, 90)
    longitude_value = normalized_reverse_coordinate(longitude, -180, 180)
    return normalize_reverse_geocode_payload(
        latitude_value,
        longitude_value,
        fetcher(latitude_value, longitude_value),
    )


def unavailable_default_location() -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "available": False,
        "provider": "none",
    }


def default_location_result(
    name: Any,
    latitude: Any,
    longitude: Any,
    provider: str,
) -> dict[str, Any]:
    safe_name = remote_display_text(name, required=True)
    if safe_name is None:
        raise DataError("default location did not include a safe place name")
    safe_name = safe_name[:40].rstrip()
    if isinstance(latitude, bool) or isinstance(longitude, bool):
        raise DataError("default location included invalid coordinates")
    latitude_value = number(latitude)
    longitude_value = number(longitude)
    if (
        latitude_value is None
        or longitude_value is None
        or not -90 <= latitude_value <= 90
        or not -180 <= longitude_value <= 180
    ):
        raise DataError("default location included invalid coordinates")
    return {
        "schemaVersion": 1,
        "available": True,
        "provider": provider,
        "name": safe_name,
        "latitude": round(latitude_value, 5),
        "longitude": round(longitude_value, 5),
    }


def read_omarchy_weather_location(path: Path | None = None) -> dict[str, Any] | None:
    target = path or omarchy_weather_location_path()
    if not target.exists():
        return None
    try:
        if not target.is_file():
            raise DataError("Omarchy weather location is not a regular file")
        if target.stat().st_size > MAX_OMARCHY_LOCATION_BYTES:
            raise DataError("Omarchy weather location exceeded the size limit")
        parsed = json.loads(target.read_text(encoding="utf-8"))
    except DataError:
        raise
    except OSError as error:
        raise DataError("Omarchy weather location could not be read") from error
    except UnicodeDecodeError as error:
        raise DataError("Omarchy weather location was not valid UTF-8") from error
    except json.JSONDecodeError as error:
        raise DataError("Omarchy weather location was not valid JSON") from error
    if not isinstance(parsed, dict):
        raise DataError("Omarchy weather location had an unsupported structure")

    name = remote_display_text(parsed.get("name"), required=True)
    if name is None:
        return None
    latitude = parsed.get("latitude")
    longitude = parsed.get("longitude")
    if latitude is None or longitude is None:
        return {"name": name}
    return default_location_result(
        name, latitude, longitude, "omarchy-weather"
    )


def wttr_display_value(value: Any) -> str | None:
    if not isinstance(value, list) or not value or not isinstance(value[0], dict):
        return None
    return remote_display_text(value[0].get("value"), required=True)


def normalize_wttr_location_payload(value: Any) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise DataError("wttr.in response was not an object")
    areas = value.get("nearest_area")
    if not isinstance(areas, list) or not areas or not isinstance(areas[0], dict):
        raise DataError("wttr.in response did not include a nearest area")
    area = areas[0]
    name = wttr_display_value(area.get("areaName"))
    if name is None:
        raise DataError("wttr.in response did not include a safe place name")
    return default_location_result(
        name,
        area.get("latitude"),
        area.get("longitude"),
        "wttr-in-ip",
    )


def fetch_wttr_location_json(opener: Any = DIRECT_OPENER) -> Any:
    raw = fetch_direct_bytes(
        WTTR_LOCATION_URL,
        MAX_WTTR_LOCATION_RESPONSE_BYTES,
        is_wttr_location_url,
        "wttr.in",
        "application/json",
        5,
        require_json=True,
        opener=opener,
    )
    try:
        return json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DataError("wttr.in response was not valid JSON") from error


def resolve_default_location(
    allow_network: bool,
    location_path: Path | None = None,
    place_searcher: Callable[[str], dict[str, Any]] = search_places,
    ip_fetcher: Callable[[], Any] = fetch_wttr_location_json,
) -> dict[str, Any]:
    configured = read_omarchy_weather_location(location_path)
    if configured and configured.get("available") is True:
        return configured
    if not allow_network:
        return unavailable_default_location()
    if configured and configured.get("name"):
        results = place_searcher(str(configured["name"]).strip()).get("results", [])
        if results:
            first = results[0]
            return default_location_result(
                first.get("name"),
                first.get("latitude"),
                first.get("longitude"),
                "omarchy-weather-search",
            )
        return unavailable_default_location()
    return normalize_wttr_location_payload(ip_fetcher())


def local_name(tag: str) -> str:
    return tag.rsplit("}", 1)[-1]


def first_descendant(element: ET.Element, name: str) -> ET.Element | None:
    for child in element.iter():
        if local_name(child.tag) == name:
            return child
    return None


def descendant_text(element: ET.Element, name: str) -> str:
    child = first_descendant(element, name)
    return safe_text(child.text if child is not None else "", 512)


def extended_data(element: ET.Element) -> dict[str, str]:
    output: dict[str, str] = {}
    for child in element.iter():
        if local_name(child.tag) != "Data":
            continue
        name = safe_text(child.attrib.get("name"), 80)
        value = first_descendant(child, "value")
        if name and value is not None:
            output[name] = safe_text(value.text, 6000)
    return output


def parse_xml(data: bytes) -> ET.Element:
    if len(data) > MAX_KML_BYTES:
        raise DataError("KML exceeded the size limit")
    try:
        return ET.fromstring(data)
    except ET.ParseError as error:
        raise DataError("NHC KML was not valid XML") from error


def extract_kml(data: bytes) -> bytes:
    if data.lstrip().startswith(b"<"):
        if len(data) > MAX_KML_BYTES:
            raise DataError("KML exceeded the size limit")
        return data

    try:
        archive = zipfile.ZipFile(io.BytesIO(data))
    except zipfile.BadZipFile as error:
        raise DataError("NHC KMZ was not a valid archive") from error

    with archive:
        files = [entry for entry in archive.infolist() if not entry.is_dir()]
        if len(files) > 40:
            raise DataError("NHC KMZ contained too many files")
        if sum(entry.file_size for entry in files) > MAX_KML_BYTES:
            raise DataError("NHC KMZ expanded beyond the size limit")
        candidates = [entry for entry in files if entry.filename.lower().endswith(".kml")]
        if len(candidates) != 1:
            raise DataError("NHC KMZ did not contain exactly one KML document")
        if candidates[0].file_size > MAX_KML_BYTES:
            raise DataError("NHC KML exceeded the size limit")
        return archive.read(candidates[0])


def coordinate_pairs(text: str) -> list[list[float]]:
    output: list[list[float]] = []
    for token in str(text or "").replace("\n", " ").split():
        fields = token.split(",")
        if len(fields) < 2:
            continue
        lon = number(fields[0])
        lat = number(fields[1])
        if lon is None or lat is None or not -180 <= lon <= 180 or not -90 <= lat <= 90:
            continue
        output.append([round(lon, 5), round(lat, 5)])
    return output


def point_distance(point: list[float], start: list[float], end: list[float]) -> float:
    x, y = point
    x1, y1 = start
    x2, y2 = end
    dx = x2 - x1
    dy = y2 - y1
    if dx == 0 and dy == 0:
        return math.hypot(x - x1, y - y1)
    amount = max(0.0, min(1.0, ((x - x1) * dx + (y - y1) * dy) / (dx * dx + dy * dy)))
    nearest_x = x1 + amount * dx
    nearest_y = y1 + amount * dy
    return math.hypot(x - nearest_x, y - nearest_y)


def simplify_line(points: list[list[float]], tolerance: float) -> list[list[float]]:
    if len(points) <= 2:
        return points[:]
    largest = 0.0
    index = 0
    for candidate in range(1, len(points) - 1):
        distance = point_distance(points[candidate], points[0], points[-1])
        if distance > largest:
            largest = distance
            index = candidate
    if largest <= tolerance:
        return [points[0], points[-1]]
    left = simplify_line(points[: index + 1], tolerance)
    right = simplify_line(points[index:], tolerance)
    return left[:-1] + right


def simplify_ring(points: list[list[float]]) -> list[list[float]]:
    if len(points) < 4:
        return points
    closed = points[0] == points[-1]
    working = points[:-1] if closed else points[:]
    if len(working) < 3:
        return points

    # Start at the westernmost vertex so the open line given to RDP is stable.
    pivot = min(range(len(working)), key=lambda index: (working[index][0], working[index][1]))
    rotated = working[pivot:] + working[:pivot] + [working[pivot]]
    simplified = simplify_line(rotated, 0.025)
    if len(simplified) > MAX_CONE_POINTS:
        stride = math.ceil(len(simplified) / MAX_CONE_POINTS)
        simplified = simplified[::stride]
        if simplified[-1] != rotated[-1]:
            simplified.append(rotated[-1])
    if simplified[0] != simplified[-1]:
        simplified.append(simplified[0])
    return simplified


def simplify_open_path(points: list[list[float]]) -> list[list[float]]:
    """Keep a source line bounded while preserving both directional endpoints."""
    if len(points) < 2:
        return []

    source_limit = MAX_CONNECTOR_POINTS * 8
    working = points
    if len(working) > source_limit:
        stride = math.ceil(len(working) / source_limit)
        working = working[::stride]
        if working[-1] != points[-1]:
            working.append(points[-1])

    simplified = simplify_line(working, 0.025)
    if len(simplified) > MAX_CONNECTOR_POINTS:
        stride = math.ceil(len(simplified) / (MAX_CONNECTOR_POINTS - 1))
        sampled = simplified[::stride][: MAX_CONNECTOR_POINTS - 1]
        if sampled[-1] != simplified[-1]:
            sampled.append(simplified[-1])
        simplified = sampled
    return simplified


def coordinate_gap_degrees(first: list[float], second: list[float]) -> float:
    """Approximate local angular distance while respecting the dateline."""
    longitude_delta = (first[0] - second[0] + 180) % 360 - 180
    mean_latitude = math.radians((first[1] + second[1]) / 2)
    return math.hypot(
        longitude_delta * max(0.1, math.cos(mean_latitude)),
        first[1] - second[1],
    )


def category_for_wind(wind_knots: int) -> int:
    if wind_knots < 64:
        return 0
    if wind_knots < 83:
        return 1
    if wind_knots < 96:
        return 2
    if wind_knots < 113:
        return 3
    if wind_knots < 137:
        return 4
    return 5


def official_mph(wind_knots: int) -> int:
    """Match NHC's whole-five mph presentation for knot-based wind values."""
    converted = max(0.0, float(wind_knots) * 1.15078)
    return int(math.floor(converted / 5.0 + 0.5) * 5)


def intensity_label(classification: str, wind_knots: int) -> str:
    category = category_for_wind(wind_knots)
    if category:
        return f"Category {category} hurricane"
    return CLASSIFICATION_LABELS.get(classification.upper(), "Tropical cyclone")


def movement_compass(degrees: int) -> str:
    labels = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]
    return labels[int((degrees % 360) / 22.5 + 0.5) % 16]


def strip_markup(value: str) -> str:
    without_tags = re.sub(r"<[^>]+>", " ", str(value or ""))
    return safe_text(html.unescape(without_tags), 256)


def html_field(description: str, pattern: str) -> str:
    match = re.search(pattern, description, flags=re.IGNORECASE | re.DOTALL)
    return strip_markup(match.group(1)) if match else ""


def parse_forecast_track(data: bytes) -> list[dict[str, Any]]:
    document = parse_xml(extract_kml(data))
    points: list[dict[str, Any]] = []
    seen: set[tuple[int, float, float]] = set()
    for placemark in document.iter():
        if local_name(placemark.tag) != "Placemark":
            continue
        point_node = first_descendant(placemark, "Point")
        if point_node is None:
            continue
        coordinates_node = first_descendant(point_node, "coordinates")
        coordinates = coordinate_pairs(coordinates_node.text if coordinates_node is not None else "")
        if not coordinates:
            continue

        description_node = first_descendant(placemark, "description")
        description = str(description_node.text or "") if description_node is not None else ""
        style = descendant_text(placemark, "styleUrl").lower()
        hour_match = re.search(r"(\d{1,3})\s*(?:hr|hour)\s+forecast", description, re.IGNORECASE)
        if hour_match:
            forecast_hour = int(hour_match.group(1))
        elif "advisory information" in description.lower() or "initial_point" in style:
            forecast_hour = 0
        else:
            continue

        wind_match = re.search(r"Maximum\s+Wind:\s*(\d+)\s*knots(?:\s*\((\d+)\s*mph\))?", description, re.IGNORECASE)
        gust_match = re.search(r"Wind\s+Gusts:\s*(\d+)\s*knots(?:\s*\((\d+)\s*mph\))?", description, re.IGNORECASE)
        wind_knots = int(wind_match.group(1)) if wind_match else 0
        wind_mph = int(wind_match.group(2)) if wind_match and wind_match.group(2) else official_mph(wind_knots)
        gust_knots = int(gust_match.group(1)) if gust_match else 0
        gust_mph = int(gust_match.group(2)) if gust_match and gust_match.group(2) else official_mph(gust_knots)
        lon, lat = coordinates[0]
        identity = (forecast_hour, lon, lat)
        if identity in seen:
            continue
        seen.add(identity)
        category = category_for_wind(wind_knots)
        points.append(
            {
                "forecastHour": forecast_hour,
                "latitude": lat,
                "longitude": lon,
                "validTimeLabel": html_field(description, r"Valid\s+at:\s*(.*?)</td>"),
                "windKnots": wind_knots,
                "windMph": wind_mph,
                "gustKnots": gust_knots,
                "gustMph": gust_mph,
                "category": category,
                "intensityLabel": intensity_label("HU" if category else "TS", wind_knots),
            }
        )

    points.sort(key=lambda point: point["forecastHour"])
    return points[:MAX_TRACK_POINTS]


def parse_cone(data: bytes) -> list[list[list[float]]]:
    document = parse_xml(extract_kml(data))
    rings: list[list[list[float]]] = []
    for polygon in document.iter():
        if local_name(polygon.tag) != "Polygon":
            continue
        outer = first_descendant(polygon, "outerBoundaryIs")
        coordinates_node = first_descendant(outer, "coordinates") if outer is not None else None
        points = coordinate_pairs(coordinates_node.text if coordinates_node is not None else "")
        if len(points) >= 4:
            rings.append(simplify_ring(points))
    return rings[:8]


def parse_best_track(data: bytes) -> list[dict[str, Any]]:
    document = parse_xml(extract_kml(data))
    points: list[dict[str, Any]] = []
    for placemark in document.iter():
        if local_name(placemark.tag) != "Placemark":
            continue
        point_node = first_descendant(placemark, "Point")
        if point_node is None:
            continue
        coordinates_node = first_descendant(point_node, "coordinates")
        coordinates = coordinate_pairs(coordinates_node.text if coordinates_node is not None else "")
        if not coordinates:
            continue
        lon, lat = coordinates[0]
        wind_knots = integer(descendant_text(placemark, "intensity"))
        classification = descendant_text(placemark, "stormType").upper()
        timestamp = descendant_text(placemark, "atcfdtg")
        iso_time = ""
        if re.fullmatch(r"\d{10}", timestamp):
            try:
                parsed = dt.datetime.strptime(timestamp, "%Y%m%d%H").replace(tzinfo=dt.timezone.utc)
                iso_time = parsed.isoformat(timespec="seconds").replace("+00:00", "Z")
            except ValueError:
                iso_time = ""
        category = category_for_wind(wind_knots)
        points.append(
            {
                "latitude": lat,
                "longitude": lon,
                "time": iso_time,
                "timeLabel": descendant_text(placemark, "dtg"),
                "classification": classification,
                "windKnots": wind_knots,
                "windMph": integer(descendant_text(placemark, "intensityMPH"), official_mph(wind_knots)),
                "pressureMb": integer(descendant_text(placemark, "minSeaLevelPres")),
                "category": category,
            }
        )
    points.sort(key=lambda point: point["time"] or point["timeLabel"])
    return points[-MAX_PAST_POINTS:]


def parse_percentage(value: Any) -> int:
    match = re.search(r"(\d{1,3})", str(value or ""))
    return max(0, min(100, int(match.group(1)))) if match else 0


def outlook_title(discussion: str) -> str:
    match = re.match(r"\s*\d+\.\s*([^:]+):", discussion)
    return safe_text(match.group(1), 120) if match else "Tropical disturbance"


def outlook_identity_name(title: str) -> tuple[str, str]:
    parenthetical = re.search(r"\(([^)]+)\)", title)
    if parenthetical:
        lifecycle_match = re.match(
            r"(Remnants? of|Post-Tropical Cyclone|Tropical Storm|Hurricane|Tropical Depression)\s+(.+)",
            parenthetical.group(1),
            flags=re.IGNORECASE,
        )
        if lifecycle_match:
            raw_lifecycle = safe_text(lifecycle_match.group(1), 48)
            lifecycle = "Remnant" if raw_lifecycle.lower().startswith("remnant") else raw_lifecycle
            return safe_text(lifecycle_match.group(2), 64), lifecycle
    return title, "Developing system"


def outlook_issue_time(document: ET.Element) -> str:
    name = descendant_text(document, "name")
    match = re.search(
        r"-\s*(?P<stamp>(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)\s+"
        r"(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)\s+"
        r"\d{1,2}\s+\d{2}:\d{2}:\d{2}\s+\d{4})\s*$",
        name,
    )
    if not match:
        return ""
    try:
        parsed = dt.datetime.strptime(match.group("stamp"), "%a %b %d %H:%M:%S %Y")
    except ValueError:
        return ""
    return parsed.replace(tzinfo=dt.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def parse_outlooks(data: bytes, source_basin: str) -> list[dict[str, Any]]:
    document = parse_xml(extract_kml(data))
    issued_at = outlook_issue_time(document)
    grouped: dict[str, dict[str, Any]] = {}
    connector_candidates: list[list[list[float]]] = []

    for placemark in document.iter():
        if local_name(placemark.tag) != "Placemark":
            continue
        fields = extended_data(placemark)
        disturbance = safe_text(fields.get("Disturbance"), 12)
        discussion = safe_text(fields.get("Discussion"), 3600)
        line_node = first_descendant(placemark, "LineString")
        if line_node is not None:
            coordinates_node = first_descendant(line_node, "coordinates")
            coordinates = coordinate_pairs(
                coordinates_node.text if coordinates_node is not None else ""
            )
            connector = simplify_open_path(coordinates)
            if connector:
                connector_candidates.append(connector)
        if not disturbance or not discussion:
            continue

        key = disturbance
        row = grouped.setdefault(
            key,
            {
                "disturbance": disturbance,
                "discussion": discussion,
                "twoDayChance": parse_percentage(fields.get("2day_percentage")),
                "twoDayCategory": safe_text(fields.get("2day_category"), 24).title(),
                "sevenDayChance": parse_percentage(fields.get("7day_percentage")),
                "sevenDayCategory": safe_text(fields.get("7day_category"), 24).title(),
                "latitude": None,
                "longitude": None,
                "area": [],
                "connector": [],
            },
        )

        point_node = first_descendant(placemark, "Point")
        if point_node is not None:
            coordinates_node = first_descendant(point_node, "coordinates")
            coordinates = coordinate_pairs(coordinates_node.text if coordinates_node is not None else "")
            if coordinates:
                row["longitude"], row["latitude"] = coordinates[0]

        polygon_node = first_descendant(placemark, "Polygon")
        if polygon_node is not None:
            outer = first_descendant(polygon_node, "outerBoundaryIs")
            coordinates_node = first_descendant(outer, "coordinates") if outer is not None else None
            coordinates = coordinate_pairs(coordinates_node.text if coordinates_node is not None else "")
            if len(coordinates) >= 4:
                row["area"].append(simplify_ring(coordinates))

    # NHC's KMZ currently omits ExtendedData from the arrow LineString. Pair
    # each line with the closest disturbance marker, orienting it away from
    # that marker and toward the potential formation area.
    for connector in connector_candidates:
        closest_row: dict[str, Any] | None = None
        closest_distance = math.inf
        reverse = False
        for row in grouped.values():
            latitude = number(row.get("latitude"))
            longitude = number(row.get("longitude"))
            if latitude is None or longitude is None:
                continue
            marker = [longitude, latitude]
            start_distance = coordinate_gap_degrees(connector[0], marker)
            end_distance = coordinate_gap_degrees(connector[-1], marker)
            distance = min(start_distance, end_distance)
            if distance < closest_distance:
                closest_row = row
                closest_distance = distance
                reverse = end_distance < start_distance
        if closest_row is not None and closest_distance <= 4.0:
            closest_row["connector"] = list(reversed(connector)) if reverse else connector

    output: list[dict[str, Any]] = []
    for row in grouped.values():
        latitude = number(row.get("latitude"))
        longitude = number(row.get("longitude"))
        if latitude is None or longitude is None:
            rings = row.get("area") if isinstance(row.get("area"), list) else []
            points = [point for ring in rings for point in ring if len(point) >= 2]
            if not points:
                continue
            longitude = sum(point[0] for point in points) / len(points)
            latitude = sum(point[1] for point in points) / len(points)

        basin = source_basin
        # The eastern-Pacific outlook includes the central North Pacific east
        # of 180°. Assign those systems to the CPHC region and let the dedicated
        # central-Pacific feed win during de-duplication below.
        if source_basin == "ep" and longitude <= -140:
            basin = "cp"

        title = outlook_title(row["discussion"])
        name, lifecycle = outlook_identity_name(title)
        output.append(
            {
                "id": f"{basin}-outlook-{row['disturbance']}",
                "name": name,
                "title": title,
                "basin": basin,
                "sourceBasin": source_basin,
                "basinLabel": BASIN_LABELS[basin],
                "classification": "REM" if lifecycle.lower().startswith("remnant") else "DB",
                "classificationLabel": lifecycle,
                "latitude": round(latitude, 4),
                "longitude": round(longitude, 4),
                "twoDayChance": row["twoDayChance"],
                "twoDayCategory": row["twoDayCategory"] or "Low",
                "sevenDayChance": row["sevenDayChance"],
                "sevenDayCategory": row["sevenDayCategory"] or "Low",
                "updatedAt": issued_at,
                "discussionExcerpt": row["discussion"],
                "discussionUrl": "https://www.nhc.noaa.gov/gtwo.php",
                "area": row["area"],
                "connector": row["connector"],
            }
        )
    return output[:MAX_OUTLOOKS]


def parse_forecast_discussion(data: bytes) -> dict[str, str]:
    try:
        source = data.decode("utf-8")
    except UnicodeDecodeError as error:
        raise DataError("NHC forecast discussion was not valid UTF-8") from error
    match = re.search(r"<pre[^>]*>(.*?)</pre>", source, flags=re.IGNORECASE | re.DOTALL)
    if not match:
        raise DataError("NHC forecast discussion did not contain a text product")

    text = html.unescape(re.sub(r"<[^>]+>", " ", match.group(1))).replace("\r", "")
    lines = [line.rstrip() for line in text.splitlines()]
    title = "NHC forecast discussion"
    title_index = 0
    for index, line in enumerate(lines):
        if " Discussion Number" in line:
            title = safe_text(line, 180)
            title_index = index
            break

    body_lines: list[str] = []
    for line in lines[title_index + 1 :]:
        if line.strip().upper().startswith("FORECAST POSITIONS AND MAX WINDS"):
            break
        body_lines.append(line)
    while body_lines and not body_lines[0].strip():
        body_lines.pop(0)
    # The office and issue-time lines precede the meteorological narrative.
    body_lines = body_lines[2:] if len(body_lines) >= 2 else body_lines
    paragraphs = [safe_text(part, 1800) for part in re.split(r"\n\s*\n", "\n".join(body_lines))]
    paragraphs = [part for part in paragraphs if part]
    excerpt = readable_excerpt(" ".join(paragraphs[:2]), 900)
    forecaster_match = re.search(r"Forecaster\s+([^\s<]+)", text, flags=re.IGNORECASE)
    return {
        "title": title,
        "excerpt": excerpt,
        "forecaster": safe_text(forecaster_match.group(1), 64) if forecaster_match else "",
    }


def nested_url(storm: dict[str, Any], key: str) -> str:
    value = storm.get(key)
    return safe_remote_url(value.get("kmzFile")) if isinstance(value, dict) else ""


def base_storm(storm: dict[str, Any]) -> tuple[dict[str, Any], dict[str, str]]:
    storm_id = safe_text(storm.get("id"), 16).lower()
    if not re.fullmatch(r"[a-z]{2}\d{6}", storm_id):
        raise DataError("NHC storm identifier was not valid")
    name = safe_text(storm.get("name"), 64) or storm_id.upper()
    classification = safe_text(storm.get("classification"), 8).upper()
    wind_knots = max(0, integer(storm.get("intensity")))
    category = category_for_wind(wind_knots)
    latitude = number(storm.get("latitudeNumeric", storm.get("latitude_numeric")))
    longitude = number(storm.get("longitudeNumeric", storm.get("longitude_numeric")))
    if latitude is None or longitude is None or not -90 <= latitude <= 90 or not -180 <= longitude <= 180:
        raise DataError("NHC storm coordinates were not valid")
    direction = integer(storm.get("movementDir")) % 360
    advisory = storm.get("publicAdvisory") if isinstance(storm.get("publicAdvisory"), dict) else {}
    discussion = storm.get("forecastDiscussion") if isinstance(storm.get("forecastDiscussion"), dict) else {}
    graphics = storm.get("forecastGraphics") if isinstance(storm.get("forecastGraphics"), dict) else {}
    basin_code = storm_id[:2]

    normalized = {
        "id": storm_id,
        "name": name,
        "basin": basin_code,
        "basinLabel": BASIN_LABELS.get(basin_code, basin_code.upper()),
        "classification": classification,
        "classificationLabel": CLASSIFICATION_LABELS.get(classification, "Tropical cyclone"),
        "category": category,
        "intensityLabel": intensity_label(classification, wind_knots),
        "windKnots": wind_knots,
        "windMph": official_mph(wind_knots),
        "pressureMb": max(0, integer(storm.get("pressure"))),
        "latitude": round(latitude, 4),
        "longitude": round(longitude, 4),
        "movementDirectionDegrees": direction,
        "movementDirectionLabel": movement_compass(direction),
        "movementSpeedMph": max(0, integer(storm.get("movementSpeed"))),
        "updatedAt": safe_text(storm.get("lastUpdate"), 40),
        "advisoryNumber": safe_text(advisory.get("advNum"), 12),
        "advisoryUrl": safe_remote_url(advisory.get("url")),
        "discussionUrl": safe_remote_url(discussion.get("url")),
        "discussionIssuedAt": safe_text(discussion.get("issuance"), 40),
        "discussionTitle": "",
        "discussionExcerpt": "",
        "discussionForecaster": "",
        "graphicsUrl": safe_remote_url(graphics.get("url")),
        "track": [],
        "pastTrack": [],
        "cone": [],
        "dataWarnings": [],
    }
    urls = {
        "track": nested_url(storm, "forecastTrack"),
        "cone": nested_url(storm, "trackCone"),
        "pastTrack": nested_url(storm, "bestTrackGIS"),
        "discussion": safe_remote_url(discussion.get("url")),
    }
    return normalized, urls


def parse_earthquake_feed(data: bytes) -> tuple[list[dict[str, Any]], str]:
    try:
        document = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DataError("USGS earthquake data was not valid JSON") from error
    if not isinstance(document, dict) or document.get("type") != "FeatureCollection":
        raise DataError("USGS earthquake data was not a GeoJSON feature collection")
    features = document.get("features")
    if not isinstance(features, list):
        raise DataError("USGS earthquake data did not contain features")

    metadata = document.get("metadata") if isinstance(document.get("metadata"), dict) else {}
    generated_at = iso_from_epoch_milliseconds(metadata.get("generated")) or utc_now()
    events: list[dict[str, Any]] = []
    for feature in features[: MAX_EARTHQUAKES * 2]:
        if not isinstance(feature, dict):
            continue
        properties = feature.get("properties")
        geometry = feature.get("geometry")
        if not isinstance(properties, dict) or not isinstance(geometry, dict):
            continue
        if str(properties.get("type") or "").lower() != "earthquake":
            continue
        coordinates = geometry.get("coordinates")
        if (
            geometry.get("type") != "Point"
            or not isinstance(coordinates, list)
            or len(coordinates) < 3
        ):
            continue
        longitude = number(coordinates[0])
        latitude = number(coordinates[1])
        depth = number(coordinates[2])
        magnitude = number(properties.get("mag"))
        event_id = safe_text(feature.get("id"), 96)
        occurred_at = iso_from_epoch_milliseconds(properties.get("time"))
        if (
            not event_id
            or magnitude is None
            or magnitude < 4.5
            or magnitude > 10
            or latitude is None
            or latitude < -90
            or latitude > 90
            or longitude is None
            or longitude < -180
            or longitude > 180
            or depth is None
            or depth < -20
            or depth > 1000
            or not occurred_at
        ):
            continue

        alert = safe_text(properties.get("alert"), 12).lower()
        if alert not in {"green", "yellow", "orange", "red"}:
            alert = ""
        status = safe_text(properties.get("status"), 20).lower()
        if status not in {"automatic", "reviewed"}:
            status = "unknown"
        felt_value = properties.get("felt")
        reported_intensity = number(properties.get("cdi"))
        estimated_intensity = number(properties.get("mmi"))
        if reported_intensity is not None and not 0 <= reported_intensity <= 10:
            reported_intensity = None
        if estimated_intensity is not None and not 0 <= estimated_intensity <= 10:
            estimated_intensity = None
        events.append(
            {
                "id": event_id,
                "kind": "earthquake",
                "name": safe_text(properties.get("place") or "Unnamed location", 180),
                "title": safe_text(properties.get("title") or "Earthquake", 220),
                "magnitude": round(magnitude, 2),
                "magnitudeType": safe_text(properties.get("magType"), 16),
                "latitude": round(latitude, 5),
                "longitude": round(longitude, 5),
                "depthKm": round(depth, 2),
                "occurredAt": occurred_at,
                "updatedAt": iso_from_epoch_milliseconds(properties.get("updated")) or occurred_at,
                "reviewStatus": status,
                "significance": max(0, integer(properties.get("sig"))),
                "feltReports": max(0, integer(felt_value)) if felt_value is not None else None,
                "reportedIntensity": reported_intensity,
                "estimatedIntensity": estimated_intensity,
                "pagerAlert": alert,
                "tsunamiInfo": integer(properties.get("tsunami")) == 1,
                "network": safe_text(properties.get("net"), 16).upper(),
                "officialUrl": safe_earthquake_url(properties.get("url")),
                "detailUrl": safe_earthquake_url(properties.get("detail")),
            }
        )

    events.sort(key=lambda event: event["occurredAt"], reverse=True)
    return events[:MAX_EARTHQUAKES], generated_at


def source_metadata() -> dict[str, str]:
    return {
        "name": "NOAA National Hurricane Center",
        "url": SOURCE_URL,
        "coverage": "Atlantic, Eastern Pacific, and Central Pacific basins",
    }


def earthquake_source_metadata() -> dict[str, str]:
    return {
        "name": "USGS Earthquake Hazards Program",
        "url": EARTHQUAKE_SOURCE_URL,
        "coverage": "Worldwide magnitude 4.5+ earthquakes from the past seven days",
    }


def build_earthquake_payload(
    fetcher: Callable[[str, int], bytes] = fetch_earthquake_bytes,
) -> dict[str, Any]:
    events, generated_at = parse_earthquake_feed(
        fetcher(EARTHQUAKES_URL, MAX_EARTHQUAKE_BYTES)
    )
    return {
        "schemaVersion": 1,
        "status": "fresh",
        "stale": False,
        "fetchedAt": generated_at,
        "checkedAt": utc_now(),
        "source": earthquake_source_metadata(),
        "error": "",
        "events": events,
    }


def build_live_payload(fetcher: Callable[[str, int], bytes] = fetch_bytes) -> dict[str, Any]:
    raw = fetcher(CURRENT_STORMS_URL, MAX_CURRENT_BYTES)
    try:
        current = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DataError("NHC current storm data was not valid JSON") from error
    rows = current.get("activeStorms") if isinstance(current, dict) else None
    if not isinstance(rows, list):
        raise DataError("NHC current storm data did not contain activeStorms")

    storms: list[dict[str, Any]] = []
    resources: list[dict[str, str]] = []
    for row in rows[:MAX_STORMS]:
        if not isinstance(row, dict):
            continue
        try:
            normalized, urls = base_storm(row)
        except DataError:
            continue
        storms.append(normalized)
        resources.append(urls)

    parser_for = {
        "track": parse_forecast_track,
        "cone": parse_cone,
        "pastTrack": parse_best_track,
        "discussion": parse_forecast_discussion,
    }
    jobs: dict[concurrent.futures.Future[bytes], tuple[int, str]] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as executor:
        for index, urls in enumerate(resources):
            for layer, url in urls.items():
                if url:
                    maximum = MAX_TEXT_BYTES if layer == "discussion" else MAX_KMZ_BYTES
                    jobs[executor.submit(fetcher, url, maximum)] = (index, layer)
                elif layer in ("track", "cone"):
                    storms[index]["dataWarnings"].append(f"{layer} unavailable")
        for future in concurrent.futures.as_completed(jobs):
            index, layer = jobs[future]
            try:
                parsed = parser_for[layer](future.result())
                if layer == "discussion":
                    storms[index]["discussionTitle"] = parsed["title"]
                    storms[index]["discussionExcerpt"] = parsed["excerpt"]
                    storms[index]["discussionForecaster"] = parsed["forecaster"]
                elif layer in ("track", "cone") and not parsed:
                    storms[index]["dataWarnings"].append(f"{layer} unavailable")
                else:
                    storms[index][layer] = parsed
            except Exception:
                storms[index]["dataWarnings"].append(f"{layer} unavailable")

    outlooks: list[dict[str, Any]] = []
    incomplete_outlook_basins: list[str] = []
    outlook_jobs: dict[concurrent.futures.Future[bytes], str] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as executor:
        for basin, url in OUTLOOK_URLS.items():
            outlook_jobs[executor.submit(fetcher, url, MAX_KMZ_BYTES)] = basin
        for future in concurrent.futures.as_completed(outlook_jobs):
            basin = outlook_jobs[future]
            try:
                outlooks.extend(parse_outlooks(future.result(), basin))
            except Exception:
                incomplete_outlook_basins.append(basin)

    # The Pacific and Central Pacific products can describe the same area.
    # Prefer the dedicated CPHC record when the point and title agree.
    unique_outlooks: dict[tuple[str, int, int, str], dict[str, Any]] = {}
    for outlook in outlooks:
        identity = (
            outlook["basin"],
            round(outlook["latitude"]),
            round(outlook["longitude"]),
            re.sub(r"[^a-z0-9]+", "", outlook["name"].lower())[:32],
        )
        existing = unique_outlooks.get(identity)
        if existing is None or len(outlook.get("area", [])) > len(existing.get("area", [])):
            unique_outlooks[identity] = outlook
    outlooks = list(unique_outlooks.values())[:MAX_OUTLOOKS]

    storms.sort(key=lambda storm: (-storm["windKnots"], storm["name"].lower()))
    outlooks.sort(key=lambda outlook: (-outlook["sevenDayChance"], outlook["name"].lower()))
    regions = []
    for basin, label in BASIN_LABELS.items():
        regions.append(
            {
                "id": basin,
                "name": label,
                "activeCount": sum(1 for storm in storms if storm["basin"] == basin),
                "outlookCount": sum(1 for outlook in outlooks if outlook["basin"] == basin),
            }
        )
    return {
        "schemaVersion": 2,
        "status": "fresh",
        "stale": False,
        "fetchedAt": utc_now(),
        "checkedAt": utc_now(),
        "source": source_metadata(),
        "error": "",
        "storms": storms,
        "outlooks": outlooks,
        "incompleteOutlookBasins": [
            basin for basin in BASIN_LABELS if basin in incomplete_outlook_basins
        ],
        "regions": regions,
    }


def valid_incomplete_outlook_basins(value: Any) -> bool:
    if not isinstance(value, list) or len(value) > len(BASIN_LABELS):
        return False
    if not all(isinstance(basin, str) and basin in BASIN_LABELS for basin in value):
        return False
    return len(set(value)) == len(value)


def valid_payload(payload: Any) -> bool:
    return (
        isinstance(payload, dict)
        and payload.get("schemaVersion") == 2
        and isinstance(payload.get("storms"), list)
        and len(payload["storms"]) <= MAX_STORMS
        and isinstance(payload.get("outlooks"), list)
        and len(payload["outlooks"]) <= MAX_OUTLOOKS
        and valid_incomplete_outlook_basins(payload.get("incompleteOutlookBasins", []))
    )


def read_cache(path: Path | None = None) -> dict[str, Any] | None:
    target = path or cache_path()
    try:
        if not target.is_file() or target.stat().st_size > MAX_CACHE_BYTES:
            return None
        payload = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return payload if valid_payload(payload) else None


def write_cache(payload: dict[str, Any], path: Path | None = None) -> None:
    target = path or cache_path()
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n"
    if len(encoded.encode("utf-8")) > MAX_CACHE_BYTES:
        raise DataError("normalized cyclone data exceeded the cache size limit")
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=target.parent, prefix=".storms.", delete=False
        ) as temporary:
            temporary_name = temporary.name
            os.chmod(temporary_name, 0o600)
            temporary.write(encoded)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_name, target)
    finally:
        if temporary_name:
            try:
                Path(temporary_name).unlink(missing_ok=True)
            except OSError:
                pass


def valid_earthquake_payload(payload: Any) -> bool:
    return (
        isinstance(payload, dict)
        and payload.get("schemaVersion") == 1
        and isinstance(payload.get("events"), list)
        and len(payload["events"]) <= MAX_EARTHQUAKES
    )


def read_earthquake_cache(path: Path | None = None) -> dict[str, Any] | None:
    target = path or earthquake_cache_path()
    try:
        if not target.is_file() or target.stat().st_size > MAX_CACHE_BYTES:
            return None
        payload = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    return payload if valid_earthquake_payload(payload) else None


def write_earthquake_cache(
    payload: dict[str, Any], path: Path | None = None
) -> None:
    target = path or earthquake_cache_path()
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n"
    if len(encoded.encode("utf-8")) > MAX_CACHE_BYTES:
        raise DataError("normalized earthquake data exceeded the cache size limit")
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            dir=target.parent,
            prefix=".earthquakes.",
            delete=False,
        ) as temporary:
            temporary_name = temporary.name
            os.chmod(temporary_name, 0o600)
            temporary.write(encoded)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_name, target)
    finally:
        if temporary_name:
            try:
                Path(temporary_name).unlink(missing_ok=True)
            except OSError:
                pass


def normalized_watch_place(value: Any) -> dict[str, Any] | None:
    if not isinstance(value, dict):
        return None
    identifier = re.sub(r"[^a-zA-Z0-9_-]+", "", str(value.get("id") or ""))[:64]
    name = safe_text(value.get("name"), 40)
    latitude = number(value.get("latitude"))
    longitude = number(value.get("longitude"))
    radius = number(value.get("radiusKm"), 1000)
    if (
        not identifier
        or not name
        or latitude is None
        or longitude is None
        or not -90 <= latitude <= 90
        or not -180 <= longitude <= 180
    ):
        return None
    return {
        "id": identifier,
        "name": name,
        "latitude": round(latitude, 5),
        "longitude": round(longitude, 5),
        "radiusKm": round(max(50, min(2000, radius or 1000))),
    }


def normalize_watch_config(value: Any) -> dict[str, Any]:
    source = value.get("places", []) if isinstance(value, dict) else []
    rows = source if isinstance(source, list) else []
    default_location_initialized = (
        isinstance(value, dict) and value.get("defaultLocationInitialized") is True
    )
    places = []
    identifiers: set[str] = set()
    for row in rows:
        place = normalized_watch_place(row)
        if place is None or place["id"] in identifiers:
            continue
        identifiers.add(place["id"])
        places.append(place)
        if len(places) >= MAX_WATCH_PLACES:
            break
    return {
        "schemaVersion": 2,
        "defaultLocationInitialized": default_location_initialized,
        "places": places,
    }


def validate_persisted_watch_config(value: Any) -> dict[str, Any]:
    version = value.get("schemaVersion") if isinstance(value, dict) else None
    if (
        not isinstance(value, dict)
        or type(version) is not int
        or version not in {1, 2}
        or not isinstance(value.get("places"), list)
        or len(value["places"]) > MAX_WATCH_PLACES
        or (version == 1 and set(value) != {"schemaVersion", "places"})
        or (
            version == 2
            and (
                set(value) != {
                    "schemaVersion", "defaultLocationInitialized", "places"
                }
                or type(value.get("defaultLocationInitialized")) is not bool
            )
        )
    ):
        raise DataError("watch-place settings had an unsupported structure")
    expected_keys = {"id", "name", "latitude", "longitude", "radiusKm"}
    places = []
    identifiers: set[str] = set()
    for row in value["places"]:
        if (
            not isinstance(row, dict)
            or set(row) != expected_keys
            or not isinstance(row.get("id"), str)
            or not isinstance(row.get("name"), str)
            or isinstance(row.get("latitude"), bool)
            or not isinstance(row.get("latitude"), (int, float))
            or isinstance(row.get("longitude"), bool)
            or not isinstance(row.get("longitude"), (int, float))
            or isinstance(row.get("radiusKm"), bool)
            or not isinstance(row.get("radiusKm"), (int, float))
        ):
            raise DataError("watch-place settings contained an invalid record")
        place = normalized_watch_place(row)
        if place is None or place["id"] in identifiers or row != place:
            raise DataError("watch-place settings contained an invalid record")
        identifiers.add(place["id"])
        places.append(place)
    return {
        "schemaVersion": 2,
        "defaultLocationInitialized": (
            value["defaultLocationInitialized"] if version == 2 else len(places) > 0
        ),
        "places": places,
    }


def read_watch_config(path: Path | None = None) -> dict[str, Any]:
    target = path or watch_config_path()
    if not target.exists():
        return normalize_watch_config({})
    try:
        if not target.is_file():
            raise DataError("watch-place settings are not a regular file")
        if target.stat().st_size > MAX_WATCH_CONFIG_BYTES:
            raise DataError("watch-place settings exceeded the size limit")
        parsed = json.loads(target.read_text(encoding="utf-8"))
    except DataError:
        raise
    except OSError as error:
        raise DataError("watch-place settings could not be read") from error
    except UnicodeDecodeError as error:
        raise DataError("watch-place settings were not valid UTF-8") from error
    except json.JSONDecodeError as error:
        raise DataError("watch-place settings were not valid JSON") from error
    return validate_persisted_watch_config(parsed)


def write_watch_config(value: Any, path: Path | None = None) -> dict[str, Any]:
    target = path or watch_config_path()
    payload = normalize_watch_config(value)
    target.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    encoded = json.dumps(payload, ensure_ascii=False, indent=2) + "\n"
    if len(encoded.encode("utf-8")) > MAX_WATCH_CONFIG_BYTES:
        raise DataError("watch-place settings exceeded the size limit")
    temporary_name = ""
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=target.parent,
            prefix=".watch-places.", delete=False
        ) as temporary:
            temporary_name = temporary.name
            os.chmod(temporary_name, 0o600)
            temporary.write(encoded)
            temporary.flush()
            os.fsync(temporary.fileno())
        os.replace(temporary_name, target)
    finally:
        if temporary_name:
            try:
                Path(temporary_name).unlink(missing_ok=True)
            except OSError:
                pass
    return payload


def unavailable_payload(message: str, cached: dict[str, Any] | None = None) -> dict[str, Any]:
    if cached:
        payload = copy.deepcopy(cached)
        payload["status"] = "cached"
        payload["stale"] = True
        payload["checkedAt"] = utc_now()
        payload["error"] = message
        return payload
    return {
        "schemaVersion": 2,
        "status": "error",
        "stale": False,
        "fetchedAt": "",
        "checkedAt": utc_now(),
        "source": source_metadata(),
        "error": message,
        "storms": [],
        "outlooks": [],
        "incompleteOutlookBasins": list(BASIN_LABELS),
        "regions": [
            {"id": basin, "name": label, "activeCount": 0, "outlookCount": 0}
            for basin, label in BASIN_LABELS.items()
        ],
    }


def fetch_with_fallback(
    fetcher: Callable[[str, int], bytes] = fetch_bytes,
    path: Path | None = None,
) -> dict[str, Any]:
    try:
        payload = build_live_payload(fetcher)
        write_cache(payload, path)
        return payload
    except Exception as error:
        print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
        return unavailable_payload(
            "The National Hurricane Center is unavailable. Showing the last saved advisory when possible.",
            read_cache(path),
        )


def unavailable_earthquake_payload(
    message: str, cached: dict[str, Any] | None = None
) -> dict[str, Any]:
    if cached:
        payload = copy.deepcopy(cached)
        payload["status"] = "cached"
        payload["stale"] = True
        payload["checkedAt"] = utc_now()
        payload["error"] = message
        return payload
    return {
        "schemaVersion": 1,
        "status": "error",
        "stale": False,
        "fetchedAt": "",
        "checkedAt": utc_now(),
        "source": earthquake_source_metadata(),
        "error": message,
        "events": [],
    }


def fetch_earthquakes_with_fallback(
    fetcher: Callable[[str, int], bytes] = fetch_earthquake_bytes,
    path: Path | None = None,
) -> dict[str, Any]:
    try:
        payload = build_earthquake_payload(fetcher)
        write_earthquake_cache(payload, path)
        return payload
    except Exception as error:
        print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
        return unavailable_earthquake_payload(
            "The USGS earthquake feed is unavailable. Showing saved events when possible.",
            read_earthquake_cache(path),
        )


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, ensure_ascii=False, separators=(",", ":")))


def main(argv: Iterable[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("fetch", help="Fetch live NHC data, falling back to the local cache")
    subparsers.add_parser("cache", help="Print the last cached response without using the network")
    subparsers.add_parser(
        "fetch-earthquakes",
        help="Fetch recent USGS earthquakes, falling back to the local cache",
    )
    subparsers.add_parser(
        "earthquake-cache",
        help="Print the last cached earthquake response without using the network",
    )
    subparsers.add_parser("watch-load", help="Print locally saved watch places")
    watch_save = subparsers.add_parser("watch-save", help="Validate and save watch places locally")
    watch_save.add_argument("payload", help="JSON watch-place payload")
    place_search = subparsers.add_parser(
        "place-search", help="Search for a map location through Open-Meteo"
    )
    place_search.add_argument("query", help="City, region, or postal code")
    place_reverse = subparsers.add_parser(
        "place-reverse", help="Name a user-selected map coordinate through Nominatim"
    )
    place_reverse.add_argument("latitude", type=float, help="WGS84 latitude")
    place_reverse.add_argument("longitude", type=float, help="WGS84 longitude")
    default_location = subparsers.add_parser(
        "default-location",
        help="Resolve the user's one-time default alert location",
    )
    default_location.add_argument(
        "--allow-network",
        action="store_true",
        help="Allow coarse IP location or a configured-name lookup",
    )
    args = parser.parse_args(list(argv) if argv is not None else None)

    if args.command == "fetch":
        emit(fetch_with_fallback())
        return 0

    if args.command == "fetch-earthquakes":
        emit(fetch_earthquakes_with_fallback())
        return 0

    if args.command == "earthquake-cache":
        cached = read_earthquake_cache()
        if cached:
            payload = copy.deepcopy(cached)
            payload["status"] = "cached"
            payload["stale"] = True
            payload["checkedAt"] = utc_now()
            emit(payload)
            return 0
        emit(unavailable_earthquake_payload(
            "No saved USGS earthquake data is available yet."
        ))
        return 0

    if args.command == "watch-load":
        try:
            emit(read_watch_config())
            return 0
        except DataError as error:
            print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
            return 2

    if args.command == "watch-save":
        try:
            requested = json.loads(args.payload)
            emit(write_watch_config(requested))
            return 0
        except (json.JSONDecodeError, OSError, DataError) as error:
            print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
            return 2

    if args.command == "place-search":
        try:
            emit(search_places(args.query))
            return 0
        except DataError as error:
            print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
            return 2

    if args.command == "place-reverse":
        try:
            emit(reverse_geocode_place(args.latitude, args.longitude))
            return 0
        except DataError as error:
            print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
            return 2

    if args.command == "default-location":
        try:
            emit(resolve_default_location(args.allow_network))
            return 0
        except DataError as error:
            print(f"hurricane-tracker-data: {safe_text(error, 240)}", file=sys.stderr)
            return 2

    cached = read_cache()
    if cached:
        payload = copy.deepcopy(cached)
        payload["status"] = "cached"
        payload["stale"] = True
        payload["checkedAt"] = utc_now()
        emit(payload)
        return 0
    emit(unavailable_payload("No saved NHC advisory is available yet."))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
