[Desktop Entry]
Type=Application
Version=1.0
Name=Hurricane + Earthquake Tracker
GenericName=Hazard Tracker
Comment=Track NHC tropical cyclones, location alerts, and recent USGS earthquakes
Exec=omarchy-shell shell summon io.github.olivoil.hurricane-tracker {}
TryExec=omarchy-shell
Icon=@ICON@
Terminal=false
StartupNotify=false
Categories=Utility;
Keywords=hurricane;storm;tropical;weather;forecast;cyclone;earthquake;USGS;NHC;NOAA;
X-Hurricane-Tracker-Managed=true
